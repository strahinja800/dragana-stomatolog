# ==============================================
# Database (PostgreSQL)
# ==============================================
# Pooled connection, used by the running app.
# On Neon this is the host containing "-pooler".
DATABASE_URL=postgres://user:password@host-pooler:5432/database

# Direct connection, used only by Prisma CLI for migrations.
# PgBouncer does not handle DDL reliably, so migrations bypass the pooler.
# Both variables are written automatically by `neon env pull` into .env.
DATABASE_URL_UNPOOLED=postgres://user:password@host:5432/database

# ==============================================
# Better Auth
# ==============================================
# Secret key for session encryption (min 32 chars)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here-min-32-characters

# Base URL of your app
BETTER_AUTH_URL=http://localhost:3000

# ==============================================
# App URLs
# ==============================================
# Do NOT add a trailing slash. It is stripped defensively in lib/auth-server.ts,
# but a clean value keeps Better Auth trustedOrigins predictable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Note: on Vercel, VERCEL_URL is injected automatically and is used by
# trpc/client.tsx for server-side requests. Do not set it by hand.

# ==============================================
# Email (Resend)
# ==============================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=DENTALHOLIST <no-reply@your-domain.com>
CLINIC_EMAIL=info@dentalholist.rs
CLINIC_NAME=DENTALHOLIST KONCEPT
CLINIC_TIMEZONE=Europe/Belgrade

# ==============================================
# Cron Security
# ==============================================
CRON_SECRET=change-this-long-random-secret

# ==============================================
# Admin seed (only needed when running `npm run seed:admin`)
# ==============================================
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=at-least-8-characters
ADMIN_NAME=Administrator

# ==============================================
# Cloudflare R2 Storage
# ==============================================
# Found in the Cloudflare dashboard URL and under R2 API tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=dental-clinic

# Public base URL of the bucket, either an r2.dev address or a custom domain.
# Must be reachable without credentials, since blog images are served from it.
R2_PUBLIC_URL=https://cdn.your-domain.com
