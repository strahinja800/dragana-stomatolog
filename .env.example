# ==============================================
# Database (PostgreSQL)
# ==============================================
# Connection string for PostgreSQL database (e.g., Neon, Supabase, or local)
DATABASE_URL=postgres://user:password@host:5432/database

# ==============================================
# Better Auth
# ==============================================
# Secret key for session encryption (min 32 chars)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here-min-32-characters

# Base URL of your app
BETTER_AUTH_URL=http://localhost:3000

# ==============================================
# App URLs
# ==============================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================
# MinIO / S3 Storage (optional)
# ==============================================
SERVICE_PASSWORD_MINIO=your-minio-password
SERVICE_USER_MINIO=your-minio-user
MINIO_BROWSER_REDIRECT_URL=https://your-console.domain.com
MINIO_ROOT_PASSWORD=$SERVICE_PASSWORD_MINIO
MINIO_ROOT_USER=$SERVICE_USER_MINIO
MINIO_SERVER_URL=https://your-s3.domain.com
S3_HOST=your-s3.domain.com
S3_BUCKET=your-bucket-name

# ==============================================
# Deployment (optional)
# ==============================================
NIXPACKS_NODE_VERSION=22
