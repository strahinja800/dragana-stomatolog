# ==============================================
# Next.js Environment Variables (build-time)
# ==============================================

# Convex Configuration
# Development deployment - shared by all team members
CONVEX_DEPLOYMENT=dev:laudable-lynx-642
NEXT_PUBLIC_CONVEX_URL=https://laudable-lynx-642.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://laudable-lynx-642.convex.site

# Site URL (change for production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth Client Configuration
BETTER_AUTH_URL=http://localhost:3000

# ==============================================
# Convex Environment Variables (runtime)
# ==============================================
# These must be set using: npx convex env set <name> <value>
# They are NOT read from .env files - they run inside Convex runtime
#
# Required Convex env vars:
#   npx convex env set SITE_URL http://localhost:3000
#   npx convex env set BETTER_AUTH_SECRET $(openssl rand -base64 32)
#
# To check current values:
#   npx convex env list
